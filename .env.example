# Copy to .env (which is never committed) and fill in. Used by compose.yaml.

# Password for the server's database account. Use a long random one.
OPENHOLD_DB_PASSWORD=

# The port people's PCs connect to.
OPENHOLD_PORT=8080

# This server's site: a short code and a name people recognise (e.g. HQ / Head office).
OPENHOLD_SITE_ID=HQ
OPENHOLD_SITE_NAME=Head office

# The address PCs use to reach this server, e.g. https://openhold.example.com. Optional.
OPENHOLD_PUBLIC_URL=

# The first administrator's username. On the first start this account is created with a temporary password,
# which must be changed at first sign-in. Leave OPENHOLD_INITIAL_ADMIN_PASSWORD empty to have one generated and
# written to /data/keys/initial-admin-password.txt in the server's volume.
OPENHOLD_ADMIN=admin
OPENHOLD_INITIAL_ADMIN_PASSWORD=
