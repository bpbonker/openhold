<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Company>Brenden Pieter Bonker</Company>
    <Authors>Brenden Pieter Bonker</Authors>
    <Copyright>Copyright (c) 2026 Brenden Pieter Bonker. Licensed under the Apache License 2.0.</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Product>Openhold</Product>
    <!-- Beta of 1.0: drop the suffix when the release checklist (docs/release-1.0.md) is complete. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>beta.1</VersionSuffix>
  </PropertyGroup>
</Project>
