{
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://*:5443",
        "Certificate": {
          "Subject": "openhold.example.com",
          "Store": "My",
          "Location": "LocalMachine",
          "AllowInvalid": false
        }
      }
    }
  },
  "Openhold": {
    "Role": "Authority",
    "SiteId": "HQ",
    "SiteName": "Head office",
    "AuthMode": "Production",
    "PublicUrl": "https://openhold.example.com:5443",
    "Administrators": [ "EXAMPLE\\openhold-admin" ],
    "Authentication": {
      "Windows": true,
      "LocalAccounts": true,
      "HomeDomains": [ "EXAMPLE", "example.local", "example.com" ],
      "OpenIdConnect": [],
      "SigningKeyPath": "D:/OpenholdData/keys/token-signing-key.pem"
    },
    "LogFolder": "D:/OpenholdData/logs",
    "LogRetentionDays": 365,
    "Vaults": [
      {
        "Name": "Production",
        "Primary": "Host=localhost;Port=5432;Database=openhold;Username=openhold",
        "ChunkStorePath": "D:/OpenholdData/chunks/production"
      }
    ]
  }
}
