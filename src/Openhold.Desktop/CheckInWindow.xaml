<Window x:Class="Openhold.Desktop.CheckInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Openhold: Check In" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Check _In" IsDefault="True" Click="CheckIn_Click" />
                <Button Content="Cancel" IsCancel="True" />
            </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
            <TextBlock x:Name="Heading" Style="{StaticResource DialogTitle}" />
            <TextBlock x:Name="FileList" Style="{StaticResource DialogIntro}" />
        </StackPanel>
        <StackPanel Margin="{StaticResource DialogBodyPadding}">
            <Label Content="_What changed?" Target="{Binding ElementName=CommentBox}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="CommentBox" Height="72" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="False" />
            <CheckBox x:Name="KeepBox" Content="_Keep checked out so I can carry on editing" Margin="0,14,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
