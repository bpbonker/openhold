<Window x:Class="Openhold.Desktop.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Openhold: Sign In" Width="460" SizeToContent="Height" ResizeMode="NoResize" Icon="Openhold.ico"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NextButton" Content="_Sign In" IsDefault="True" Click="Next_Click" />
                <Button Content="Cancel" IsCancel="True" />
            </StackPanel>
        </Border>

        <!-- A thin brand line across the top marks this as Openhold's own sign-in. -->
        <Border DockPanel.Dock="Top" Height="4" Background="{DynamicResource Brand}" />
        <DockPanel DockPanel.Dock="Top" Margin="28,24,28,0">
            <Image Source="Openhold.ico" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="Openhold" />
            <StackPanel>
                <TextBlock x:Name="Heading" Text="Sign in to Openhold" Style="{StaticResource DisplayText}" />
                <TextBlock x:Name="Server" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <StackPanel Margin="28,20,28,24">
            <!-- Step 1: username, password and (when two-factor is on) the code. -->
            <StackPanel x:Name="CredentialsStep">
                <Label Content="_Username" Target="{Binding ElementName=Username}" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="Username" />
                <Label Content="_Password" Target="{Binding ElementName=Password}" Style="{StaticResource NextFieldLabel}" />
                <PasswordBox x:Name="Password" />
                <StackPanel x:Name="CodePanel" Visibility="Collapsed">
                    <Label Content="_Code from your authenticator app" Target="{Binding ElementName=Code}" Style="{StaticResource NextFieldLabel}" />
                    <TextBox x:Name="Code" MaxLength="7" FontSize="{StaticResource FontSubtitle}" FontFamily="{StaticResource MonoFont}" />
                </StackPanel>
            </StackPanel>

            <!-- Step 2: a temporary password must be changed. -->
            <StackPanel x:Name="PasswordStep" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Choose your own password. Use at least 12 characters; a short sentence is easy to remember and hard to guess." />
                <Label Content="_New password" Target="{Binding ElementName=NewPassword}" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="NewPassword" />
                <Label Content="_Type it again" Target="{Binding ElementName=RepeatPassword}" Style="{StaticResource NextFieldLabel}" />
                <PasswordBox x:Name="RepeatPassword" />
            </StackPanel>

            <!-- Step 3: set up two-factor sign-in. -->
            <StackPanel x:Name="TwoFactorStep" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Your account needs two-factor sign-in. Scan this with an authenticator app (e.g. Microsoft Authenticator or Google Authenticator) on your phone, then enter the six-digit code it shows." />
                <Border Style="{StaticResource Card}" Padding="12" HorizontalAlignment="Center">
                    <Image x:Name="QrCode" Width="200" Height="200" RenderOptions.BitmapScalingMode="NearestNeighbor"
                           AutomationProperties.Name="QR code to add Openhold to your authenticator app" />
                </Border>
                <TextBlock Text="Can't scan it? Type this key into the app instead:" Style="{StaticResource CaptionText}" Margin="0,12,0,2" />
                <TextBox x:Name="SecretText" Style="{StaticResource CopyableText}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                <Label Content="_Code from the app" Target="{Binding ElementName=SetupCode}" Style="{StaticResource NextFieldLabel}" />
                <TextBox x:Name="SetupCode" MaxLength="7" FontSize="{StaticResource FontSubtitle}" FontFamily="{StaticResource MonoFont}" />
            </StackPanel>

            <Border Style="{StaticResource ErrorBar}" Margin="0,16,0,0" Visibility="{Binding Visibility, ElementName=Problem}">
                <DockPanel>
                    <TextBlock Style="{StaticResource MessageIcon}" Text="&#xE783;" Foreground="{DynamicResource DangerText}" />
                    <TextBlock x:Name="Problem" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Assertive" />
                </DockPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
