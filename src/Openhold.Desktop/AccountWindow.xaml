<Window x:Class="Openhold.Desktop.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Openhold: My Account" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Button Content="Close" IsCancel="True" HorizontalAlignment="Right" />
        </Border>
        <DockPanel DockPanel.Dock="Top" Margin="{StaticResource DialogHeaderPadding}">
            <!-- An avatar: a person glyph in a soft brand circle. -->
            <Grid Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Top">
                <Ellipse Fill="{DynamicResource InfoBg}" />
                <TextBlock Style="{StaticResource IconText}" Text="&#xE77B;" FontSize="18" Foreground="{DynamicResource Brand}" HorizontalAlignment="Center" />
            </Grid>
            <StackPanel>
                <TextBlock x:Name="Who" Style="{StaticResource DialogTitle}" />
                <TextBlock x:Name="Kind" Style="{StaticResource DialogIntro}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <StackPanel Margin="{StaticResource DialogBodyPadding}">
            <GroupBox x:Name="PasswordGroup" Header="Change password" Margin="0,0,0,12">
                <StackPanel>
                    <Label Content="_Current password" Target="{Binding ElementName=Current}" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="Current" />
                    <Label Content="_New password (at least 12 characters)" Target="{Binding ElementName=NewPassword}" Style="{StaticResource NextFieldLabel}" Margin="0,12,0,6" />
                    <PasswordBox x:Name="NewPassword" />
                    <Label Content="_Type it again" Target="{Binding ElementName=Repeat}" Style="{StaticResource NextFieldLabel}" Margin="0,12,0,6" />
                    <PasswordBox x:Name="Repeat" />
                    <Button Content="Change _Password" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ChangePassword_Click" />
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="TwoFactorGroup" Header="Two-factor sign-in">
                <StackPanel>
                    <TextBlock x:Name="TwoFactorState" TextWrapping="Wrap" />
                    <Button x:Name="SetUpButton" Content="_Set Up Two-Factor Sign-In" HorizontalAlignment="Left" Margin="0,12,0,0" Click="SetUp_Click" />
                    <StackPanel x:Name="SetUpPanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock TextWrapping="Wrap" Text="Scan this with an authenticator app on your phone, then enter the six-digit code it shows." />
                        <Border Style="{StaticResource Card}" Padding="10" Margin="0,10" HorizontalAlignment="Center">
                            <Image x:Name="QrCode" Width="180" Height="180" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   AutomationProperties.Name="QR code to add Openhold to your authenticator app" />
                        </Border>
                        <TextBox x:Name="SecretText" Style="{StaticResource CopyableText}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                        <Label Content="C_ode from the app" Target="{Binding ElementName=Code}" Style="{StaticResource NextFieldLabel}" Margin="0,12,0,6" />
                        <TextBox x:Name="Code" MaxLength="7" FontSize="{StaticResource FontSubtitle}" FontFamily="{StaticResource MonoFont}" />
                        <Button Content="_Turn On" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Confirm_Click" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- The code colours the message: blue done, red a problem; the bar takes its tint from it. -->
            <Grid Margin="0,12,0,0" Visibility="{Binding Visibility, ElementName=Message}">
                <Border CornerRadius="4" Background="{Binding Foreground, ElementName=Message}" Opacity="0.08" />
                <Border CornerRadius="4" BorderBrush="{Binding Foreground, ElementName=Message}" BorderThickness="1" Opacity="0.35" />
                <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="12,8" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>
