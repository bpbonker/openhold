<Window x:Class="Openhold.Desktop.ApprovalsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Openhold: Approvals" Width="980" Height="620" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ApproveButton" Content="Approve" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Approve_Click" IsEnabled="False" />
                    <Button x:Name="RejectButton" Content="_Reject" Click="Reject_Click" IsEnabled="False" />
                    <Button Content="Close" IsCancel="True" />
                </StackPanel>
                <!-- Withdrawing your own request is set apart from deciding on someone else's. -->
                <Button x:Name="CancelButton" Content="_Withdraw Request" HorizontalAlignment="Left" Margin="0" Click="Withdraw_Click" IsEnabled="False" />
            </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
            <TextBlock Style="{StaticResource DialogTitle}" Text="Approvals" />
            <TextBlock Style="{StaticResource DialogIntro}"
                       Text="Changes waiting for your approval, and changes you've asked for. Approving signs the change off; once every approval is in, the files change state together." />
        </StackPanel>
        <Grid Margin="{StaticResource DialogBodyPadding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <DataGrid x:Name="Requests" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="None" CanUserAddRows="False" SelectionChanged="Requests_SelectionChanged"
                          AutomationProperties.Name="Changes">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Change" Binding="{Binding Title}" Width="2*" />
                        <DataGridTextColumn Header="Asked by" Binding="{Binding RequestedBy}" Width="*" />
                        <DataGridTextColumn Header="When" Binding="{Binding When}" Width="*" />
                        <DataGridTextColumn Header="For you" Binding="{Binding ForYou}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding Visibility, ElementName=EmptyHint}">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE73E;" FontSize="32" Foreground="{DynamicResource IconMuted}"
                               HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock x:Name="EmptyHint" Text="Nothing is waiting for approval." Foreground="{DynamicResource Subtle}" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <TextBlock Text="Select a change to see its files and approvals." Style="{StaticResource SecondaryText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="24" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface}"
                                  Visibility="{Binding Visibility, ElementName=Detail}">
                        <StackPanel x:Name="Detail" Visibility="Collapsed" Margin="18,16,18,18">
                            <TextBlock x:Name="DetailTitle" Style="{StaticResource SubtitleText}" />
                            <TextBlock x:Name="DetailComment" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                            <TextBlock Text="Files" Style="{StaticResource SectionLabel}" Margin="0,18,0,6" />
                            <ItemsControl x:Name="DetailFiles" />
                            <TextBlock Text="Approvals" Style="{StaticResource SectionLabel}" Margin="0,18,0,6" />
                            <ItemsControl x:Name="DetailProgress" />
                            <ItemsControl x:Name="DetailDecisions" Margin="0,6,0,0" TextElement.Foreground="{DynamicResource Subtle}" />
                            <Label Content="Your _comment" Target="{Binding ElementName=Comment}" Margin="0,18,0,6" />
                            <TextBox x:Name="Comment" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" VerticalScrollBarVisibility="Auto" />
                            <!-- The code colours the text: red for a problem, blue for a note; the bar takes its tint from it. -->
                            <Grid Margin="0,12,0,0" Visibility="{Binding Visibility, ElementName=Problem}">
                                <Border CornerRadius="4" Background="{Binding Foreground, ElementName=Problem}" Opacity="0.08" />
                                <Border CornerRadius="4" BorderBrush="{Binding Foreground, ElementName=Problem}" BorderThickness="1" Opacity="0.35" />
                                <TextBlock x:Name="Problem" Foreground="{DynamicResource DangerText}" TextWrapping="Wrap" Margin="12,8" Visibility="Collapsed" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
