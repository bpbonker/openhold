<Window x:Class="Openhold.Desktop.TrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Openhold: Trash" Width="840" Height="540" MinWidth="520" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RestoreButton" Content="Restore" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Restore_Click" IsEnabled="False" />
                <Button Content="Close" IsCancel="True" />
            </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
            <TextBlock Style="{StaticResource DialogTitle}" Text="Trash" />
            <TextBlock Style="{StaticResource DialogIntro}"
                       Text="Deleted files stay here with their full history. Select files and click Restore to bring them back to the same folder." />
        </StackPanel>
        <Grid Margin="{StaticResource DialogBodyPadding}">
            <DataGrid x:Name="Items" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column"
                      GridLinesVisibility="None" CanUserAddRows="False" SelectionChanged="Items_SelectionChanged" AutomationProperties.Name="Deleted files">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Folder" Binding="{Binding FolderPath}" Width="2*" />
                    <DataGridTextColumn Header="Version" Binding="{Binding LatestVersion, StringFormat=v{0}}" Width="70" />
                    <DataGridTextColumn Header="Deleted" Binding="{Binding DeletedAt, StringFormat={}{0:d MMM yyyy h:mm tt}}" Width="1.3*" />
                    <DataGridTextColumn Header="By" Binding="{Binding DeletedBy}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding Visibility, ElementName=EmptyHint}">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" FontSize="32" Foreground="{DynamicResource IconMuted}"
                           HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock x:Name="EmptyHint" Text="The Trash is empty." Foreground="{DynamicResource Subtle}" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
