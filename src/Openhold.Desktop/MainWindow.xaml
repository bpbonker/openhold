<Window x:Class="Openhold.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Openhold.Desktop"
        Title="Openhold Explorer" Icon="Openhold.ico" Height="760" Width="1320" MinWidth="900" MinHeight="500"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Menu bar: every command in one place, with its keyboard shortcut; enabled for the current selection. -->
        <Menu DockPanel.Dock="Top" Padding="6,4,6,0" MenuItem.SubmenuOpened="MainMenu_SubmenuOpened">
            <MenuItem Header="_File">
                <MenuItem x:Name="MainOpen" Header="_Open" InputGestureText="Enter" Click="Open_Click" />
                <MenuItem x:Name="MainOpenPdf" Header="Open Pu_blished PDF" Click="OpenPdf_Click" />
                <MenuItem x:Name="MainShowInFolder" Header="Show in _Folder" Click="ShowInFolder_Click" />
                <Separator />
                <MenuItem Header="_Add Files to the Vault…" InputGestureText="Ctrl+Shift+A" Click="AddFiles_Click" />
                <MenuItem Header="_New Folder…" InputGestureText="Ctrl+Shift+N" Click="NewFolder_Click" />
                <Separator />
                <MenuItem x:Name="MainPackAndGo" Header="_Pack and Go…" Click="PackAndGo_Click" />
                <Separator />
                <MenuItem x:Name="MainSignOut" Header="Sign O_ut" Click="SignOut_Click" />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem x:Name="MainEditProperties" Header="Edit _Properties…" Click="EditProperties_Click" />
                <MenuItem x:Name="MainRename" Header="Re_name…" InputGestureText="F2" Click="Rename_Click" />
                <MenuItem x:Name="MainMove" Header="_Move to Folder…" Click="Move_Click" />
                <MenuItem x:Name="MainDelete" Header="_Delete" InputGestureText="Del" Click="Delete_Click" />
                <Separator />
                <MenuItem x:Name="MainCopyPath" Header="_Copy Path" InputGestureText="Ctrl+Shift+C" Click="CopyPath_Click" />
                <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Click="SelectAll_Click" />
                <Separator />
                <MenuItem Header="_Find" InputGestureText="Ctrl+F" Click="Find_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Refresh" InputGestureText="F5" Click="Refresh_Click" />
                <MenuItem Header="Property _Columns…" Click="Columns_Click" />
                <Separator />
                <MenuItem x:Name="MainHistory" Header="_History" Click="ShowHistory_Click" />
                <MenuItem x:Name="MainUses" Header="Us_es" Click="ShowUses_Click" />
                <MenuItem x:Name="MainWhereUsed" Header="_Where Used" Click="ShowWhereUsed_Click" />
                <Separator />
                <MenuItem Header="_Trash…" Click="Trash_Click" />
            </MenuItem>
            <MenuItem Header="_Actions">
                <MenuItem x:Name="MainGetLatest" Header="_Get Latest" InputGestureText="Ctrl+L" Click="GetLatest_Click" />
                <MenuItem x:Name="MainGetLatestWithUses" Header="Get Latest _With Everything It Uses" Click="GetLatestWithUses_Click" />
                <Separator />
                <MenuItem x:Name="MainCheckOut" Header="Check Ou_t" InputGestureText="Ctrl+E" Click="CheckOut_Click" />
                <MenuItem x:Name="MainCheckOutWithUses" Header="Check Out Wit_h Everything It Uses" Click="CheckOutWithUses_Click" />
                <MenuItem x:Name="MainCheckIn" Header="Check _In…" InputGestureText="Ctrl+I" Click="CheckIn_Click" />
                <MenuItem x:Name="MainUndo" Header="_Undo Check Out" Click="Undo_Click" />
                <Separator />
                <MenuItem x:Name="MainChangeState" Header="Change _State…" Click="ChangeState_Click" />
                <MenuItem x:Name="MainRevise" Header="Re_vise…" Click="Revise_Click" />
                <MenuItem x:Name="MainChangeCategory" Header="Change C_ategory…" Click="ChangeCategory_Click" />
                <MenuItem x:Name="MainCopyDesign" Header="Cop_y Design…" Click="CopyDesign_Click" />
                <Separator />
                <MenuItem Header="A_pprovals…" Click="Approvals_Click" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Cata_logue…" Click="Catalogue_Click" />
                <MenuItem Header="_New Number…" Click="NewNumber_Click" />
                <Separator />
                <MenuItem x:Name="MainAdministration" Header="_Administration…" Click="Administration_Click" />
                <MenuItem Header="My A_ccount…" Click="Account_Click" />
                <MenuItem Header="_Settings…" Click="Settings_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard Shortcuts" Click="Shortcuts_Click" />
                <MenuItem Header="What the _Status Marks Mean" Click="Legend_Click" />
                <Separator />
                <MenuItem Header="_About Openhold" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="8,6,12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="300">
                        <TextBox x:Name="SearchBox" Padding="30,6,60,6" VerticalContentAlignment="Center" AutomationProperties.Name="Search the vault"
                                 KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"
                                 ToolTip="Search names, properties and comments. Use Property:value to search one property, * as a wildcard, quotes for phrases." />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="14" Margin="10,0,0,0"
                                   Foreground="{DynamicResource Subtle}" IsHitTestVisible="False" />
                        <TextBlock x:Name="SearchHint" Text="Search the vault" Margin="32,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Subtle}" IsHitTestVisible="False" />
                        <Border Style="{StaticResource KeyCap}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"
                                Visibility="{Binding Visibility, ElementName=SearchHint}">
                            <TextBlock Text="Ctrl+F" FontSize="11" Foreground="{DynamicResource Subtle}" />
                        </Border>
                    </Grid>
                    <CheckBox x:Name="SearchThisFolder" Content="This folder only" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <WrapPanel KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                    <Button x:Name="GetLatestButton" Style="{StaticResource ToolButton}" Click="GetLatest_Click" AutomationProperties.Name="Get Latest"
                            ToolTip="Update the selected files to the newest version in the vault">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE896;" Margin="0,0,8,0" />
                            <TextBlock Text="Get Latest" />
                        </StackPanel>
                    </Button>
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <Button x:Name="CheckOutButton" Style="{StaticResource ToolButton}" Click="CheckOut_Click" AutomationProperties.Name="Check Out"
                            ToolTip="Check out the selected files so you can edit them. Nobody else can change them until you check in.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE70F;" Margin="0,0,8,0" />
                            <TextBlock Text="Check Out" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CheckInButton" Style="{StaticResource ToolButton}" Click="CheckIn_Click" AutomationProperties.Name="Check In"
                            ToolTip="Save your changes to the vault as a new version, or add new files">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE898;" Margin="0,0,8,0" />
                            <TextBlock Text="Check In" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="UndoButton" Style="{StaticResource ToolButton}" Click="Undo_Click" AutomationProperties.Name="Undo Check Out"
                            ToolTip="Release the selected files without checking in. Your changes are kept in a backup.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE7A7;" Margin="0,0,8,0" />
                            <TextBlock Text="Undo Check Out" />
                        </StackPanel>
                    </Button>
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <Button x:Name="OpenButton" Style="{StaticResource ToolButton}" Click="Open_Click" AutomationProperties.Name="Open"
                            ToolTip="Open the file in its program (downloads it first if needed)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" Margin="0,0,8,0" />
                            <TextBlock Text="Open" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ShowInFolderButton" Style="{StaticResource ToolButton}" Click="ShowInFolder_Click"
                            ToolTip="Show in Folder: show the file in Windows Explorer" AutomationProperties.Name="Show in Folder">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="NewFolder_Click" ToolTip="New Folder: create a folder in the vault" AutomationProperties.Name="New Folder">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8F4;" />
                    </Button>
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Click="Refresh_Click" ToolTip="Refresh (F5)" AutomationProperties.Name="Refresh">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" />
                    </Button>
                    <Button x:Name="ApprovalsButton" Style="{StaticResource ToolButton}" Click="Approvals_Click" AutomationProperties.Name="{Binding Text, ElementName=ApprovalsText}"
                            ToolTip="Changes waiting for your approval, and changes you've asked for">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8FB;" Margin="0,0,8,0" />
                            <TextBlock x:Name="ApprovalsText" Text="Approvals" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Trash_Click" ToolTip="Trash: deleted files, which you can restore with their history" AutomationProperties.Name="Trash">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Settings_Click" ToolTip="Settings: which server this PC uses and where the workspace is" AutomationProperties.Name="Settings">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" />
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Status line: the result of the last action, in plain words -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="12,5" Background="{DynamicResource Chrome}"
                TextElement.FontSize="{StaticResource FontCaption}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE77B;" FontSize="12" Foreground="{DynamicResource Subtle}" Margin="0,0,6,0" />
                    <TextBlock x:Name="Identity" Foreground="{DynamicResource Subtle}" />
                </StackPanel>
                <TextBlock x:Name="StatusLine" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Text="Ready." AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="380" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- Folder tree -->
            <DockPanel Background="{DynamicResource SurfaceSubtle}">
            <TextBlock DockPanel.Dock="Top" Text="Folders" Style="{StaticResource SectionLabel}" Height="44" Padding="16,16,12,0" />
            <TreeView x:Name="Folders" AutomationProperties.Name="Vault folders" BorderThickness="0" Padding="6,0,6,6" SelectedItemChanged="Folders_SelectedItemChanged"
                      PreviewMouseRightButtonDown="Folders_PreviewMouseRightButtonDown">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" Foreground="{DynamicResource FolderIcon}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="_Get Latest for This Folder" Click="FolderGetLatest_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE896;" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_New Folder…" Click="NewFolder_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8F4;" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Delete Empty Folder" Click="DeleteFolder_Click"
                                  ToolTip="Removes the folder if nothing is in it (files and folders inside must be moved or deleted first)">
                            <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Trash…" Click="Trash_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Show in _Folder" Click="FolderShowInExplorer_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE838;" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Refresh" Click="Refresh_Click" InputGestureText="F5">
                            <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </TreeView.ContextMenu>
            </TreeView>
            </DockPanel>

            <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource Divider}" HorizontalAlignment="Center" IsHitTestVisible="False" />
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" Width="5" AutomationProperties.Name="Resize the folder pane" />

            <!-- Files -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="FolderPath" Style="{StaticResource SubtitleText}" Height="44" Padding="14,11,14,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <DataGrid x:Name="Files" Grid.Row="1" AutomationProperties.Name="Files" PreviewKeyDown="Files_PreviewKeyDown" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                          HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" RowHeight="30"
                          AllowDrop="True" Drop="Files_Drop" DragOver="Files_DragOver"
                          MouseDoubleClick="Files_MouseDoubleClick" SelectionChanged="Files_SelectionChanged"
                          AlternatingRowBackground="{DynamicResource SurfaceStripe}" CanUserAddRows="False"
                          PreviewMouseRightButtonDown="Files_PreviewMouseRightButtonDown">
                    <DataGrid.ContextMenu>
                        <ContextMenu Opened="FilesMenu_Opened">
                            <MenuItem x:Name="MenuOpen" Header="_Open" FontWeight="SemiBold" Click="Open_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="MenuGetLatest" Header="_Get Latest" Click="GetLatest_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE896;" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuGetLatestWithUses" Header="Get Latest _With Everything It Uses" Click="GetLatestWithUses_Click" />
                            <MenuItem x:Name="MenuCheckOut" Header="Check Ou_t" Click="CheckOut_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE70F;" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuCheckOutWithUses" Header="Check Out Wit_h Everything It Uses" Click="CheckOutWithUses_Click" />
                            <MenuItem x:Name="MenuCheckIn" Header="Check _In…" Click="CheckIn_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE898;" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuUndo" Header="_Undo Check Out" Click="Undo_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE7A7;" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="MenuHistory" Header="_History" Click="ShowHistory_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE81C;" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuUses" Header="Us_es" Click="ShowUses_Click" />
                            <MenuItem x:Name="MenuWhereUsed" Header="_Where Used" Click="ShowWhereUsed_Click" />
                            <Separator />
                            <MenuItem x:Name="MenuEditProperties" Header="Edit _Properties…" Click="EditProperties_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE70F;" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuRevise" Header="Re_vise…" Click="Revise_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8CB;" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuChangeState" Header="Change _State…" Click="ChangeState_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE73E;" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuAddToCatalogue" Header="Add to Cata_logue…" Click="AddToCatalogue_Click"
                                      ToolTip="Give this part a universal part number in the catalogue, or open its item if it has one" />
                            <MenuItem x:Name="MenuFillFromCatalogue" Header="Fill iProperties from Catalogue" Click="FillFromCatalogue_Click"
                                      ToolTip="Write the catalogue item's part number, description, vendor (manufacturer) and stock number (their part number) into the file" />
                            <MenuItem x:Name="MenuChangeCategory" Header="Change C_ategory…" Click="ChangeCategory_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8EC;" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="MenuRename" Header="Re_name…" Click="Rename_Click" InputGestureText="F2">
                                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8AC;" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuMove" Header="_Move to Folder…" Click="Move_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8DE;" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuCopyDesign" Header="Cop_y Design…" Click="CopyDesign_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xF413;" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuDelete" Header="_Delete" Click="Delete_Click" InputGestureText="Del">
                                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="MenuShowInFolder" Header="Show in _Folder" Click="ShowInFolder_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE838;" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuOpenPdf" Header="Open Pu_blished PDF" Click="OpenPdf_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xEA90;" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuPackAndGo" Header="Pac_k and Go…" Click="PackAndGo_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE7B8;" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuCopyPath" Header="_Copy Path" Click="CopyPath_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Name" Width="2*" MinWidth="250" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent"
                                                ToolTip="" ToolTipService.InitialShowDelay="400" ToolTipOpening="Name_ToolTipOpening">
                                        <!-- Autodesk Vault-style status: the bubble is this PC's copy, the X is a check-out. -->
                                        <Grid Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip="{Binding BubbleTip}"
                                              AutomationProperties.Name="{Binding BubbleTip}">
                                            <Ellipse StrokeThickness="1.3" Fill="{Binding BubbleFill}" Stroke="{Binding BubbleStroke}" StrokeDashArray="{Binding BubbleDash}" />
                                            <TextBlock Text="{Binding BubbleMark}" Foreground="{Binding BubbleMarkBrush}" FontSize="9" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="11" FontWeight="Bold" Width="14"
                                                   Foreground="{Binding CheckOutBrush}" Visibility="{Binding CheckOutVisibility}"
                                                   Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="{Binding CheckOutTip}"
                                                   AutomationProperties.Name="{Binding CheckOutTip}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="Auto" MinWidth="150" />
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70" MinWidth="70" />
                        <DataGridTemplateColumn x:Name="StateColumn" Header="State" Width="Auto" MinWidth="120" SortMemberPath="State">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Chip}" Background="{Binding StateBackground}"
                                            HorizontalAlignment="Left" Visibility="{Binding StateVisibility}" ToolTip="{Binding StateTip}">
                                        <TextBlock Text="{Binding State}" Foreground="{Binding StateForeground}" FontSize="{StaticResource FontCaption}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="Auto" MinWidth="100" />
                        <DataGridTextColumn x:Name="FolderColumn" Header="Folder" Binding="{Binding FolderPath}" Width="Auto" MinWidth="140" Visibility="Collapsed" />
                        <DataGridTextColumn x:Name="MatchColumn" Header="Found because" Binding="{Binding Match}" Width="Auto" MinWidth="160" Visibility="Collapsed" />
                        <DataGridTextColumn Header="Checked out by" Binding="{Binding CheckedOutBy}" Width="Auto" MinWidth="120" />
                        <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="Auto" MinWidth="150" />
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
                <!-- Shown with the hint's own visibility, so the code-behind only changes the hint. -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding Visibility, ElementName=EmptyHint}">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" FontSize="40" Foreground="{DynamicResource IconMuted}"
                               HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock x:Name="EmptyHint" Foreground="{DynamicResource Subtle}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                               Text="This folder is empty.&#10;Drag files here from Windows Explorer to add them to the vault." />
                </StackPanel>
            </Grid>

            <Rectangle Grid.Column="3" Width="1" Fill="{DynamicResource Divider}" HorizontalAlignment="Center" IsHitTestVisible="False" />
            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" Width="5" AutomationProperties.Name="Resize the details pane" />

            <!-- Details -->
            <TabControl Grid.Column="4" Padding="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                        <Setter Property="MinHeight" Value="44" />
                    </Style>
                </TabControl.Resources>
                <TabItem Header="Details">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,14,14,16">
                            <!-- Preview: always here, so it's clear what's selected; says why when there's no picture. -->
                            <Border Height="210" Background="{DynamicResource SurfaceSubtle}" BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                    CornerRadius="6" Margin="0,0,0,14">
                                <Grid>
                                    <Image x:Name="DetailThumbnail" Stretch="Uniform" Margin="10" RenderOptions.BitmapScalingMode="HighQuality"
                                           AutomationProperties.Name="Preview of the selected file" />
                                    <StackPanel x:Name="PreviewPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource IconText}" FontSize="40" Text="&#xE8A5;" Foreground="{DynamicResource IconMuted}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="PreviewNote" Foreground="{DynamicResource Subtle}" Margin="16,10,16,0" TextAlignment="Center"
                                                   TextWrapping="Wrap" MaxWidth="280" Text="Select a file to see its preview" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="DetailName" Style="{StaticResource SubtitleText}" Text="Select a file" />
                            <TextBlock x:Name="DetailStatus" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                            <TextBlock Text="Properties" Margin="0,18,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=DetailProperties}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl x:Name="DetailProperties">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Subtle}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="HistoryTab" Header="History">
                    <DataGrid x:Name="History" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="None" BorderThickness="0" CanUserAddRows="False" SelectionMode="Single"
                              MouseDoubleClick="OpenVersion_Click">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="_Open This Version" FontWeight="SemiBold" Click="OpenVersion_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_Restore This Version…" Click="RestoreVersion_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE777;" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Version" Binding="{Binding Version, StringFormat=v{0}}" Width="72" />
                            <DataGridTextColumn Header="When" Binding="{Binding When}" Width="150" />
                            <DataGridTextColumn Header="Who" Binding="{Binding Who}" Width="100" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="Auto" />
                            <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem x:Name="UsesTab" Header="Uses">
                    <ListBox x:Name="Uses" BorderThickness="0" />
                </TabItem>
                <TabItem x:Name="WhereUsedTab" Header="Where Used">
                    <ListBox x:Name="WhereUsed" BorderThickness="0" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
