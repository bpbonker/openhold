<Window x:Class="Openhold.Desktop.EditPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Openhold: Edit Properties" Width="740" Height="660" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SaveButton" Content="Save" IsDefault="True" Click="Save_Click" />
                    <Button Content="Cancel" IsCancel="True" />
                </StackPanel>
                <Button Content="_Add Property…" HorizontalAlignment="Left" Margin="0" Click="AddProperty_Click" />
            </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
            <TextBlock x:Name="Heading" Style="{StaticResource DialogTitle}" Text="Edit properties" />
            <TextBlock x:Name="Intro" Style="{StaticResource DialogIntro}" />
        </StackPanel>
        <DockPanel Margin="{StaticResource DialogBodyPadding}">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Label Content="_Comment for the new version" Target="{Binding ElementName=Comment}" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="Comment" />
                <Border Style="{StaticResource WarningBar}" Margin="0,12,0,0" Visibility="{Binding Visibility, ElementName=RevisionNote}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource MessageIcon}" Text="&#xE7BA;" Foreground="{DynamicResource WarningText}" />
                        <TextBlock x:Name="RevisionNote" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" Visibility="Collapsed"
                                   Text="You're changing the revision. Openhold never changes it by itself. To start a new revision, use Revise, which also reopens released files; change it here only to correct it." />
                    </DockPanel>
                </Border>
            </StackPanel>
            <DataGrid x:Name="Items" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource Divider}" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" CellEditEnding="Items_CellEditEnding" AutomationProperties.Name="Properties">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Property" Binding="{Binding Name}" IsReadOnly="True" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Edited}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Value" Width="1.6*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Value}" />
                                    <TextBlock x:Name="Varies" Text="(differs between files)" FontStyle="Italic"
                                               Foreground="{DynamicResource Subtle}" Visibility="Collapsed" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ShowsVaries}" Value="True">
                                        <Setter TargetName="Varies" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Padding="0,3" Background="Transparent"
                                         FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Saved In" Binding="{Binding SavedIn}" IsReadOnly="True" Width="0.8*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Subtle}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>
