<Window x:Class="Openhold.Desktop.CopyDesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Openhold: Copy Design" Width="920" Height="640" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CopyButton" Content="Copy" IsDefault="True" Click="Copy_Click" />
                    <Button Content="Cancel" IsCancel="True" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" Foreground="{DynamicResource FolderIcon}" Margin="0,0,8,0" />
                    <TextBlock Text="Put the copies in" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Subtle}" />
                    <TextBlock x:Name="TargetText" VerticalAlignment="Center" FontWeight="SemiBold" Text="the same folder as each original" />
                    <Button Content="C_hange…" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" MinWidth="0" Foreground="{DynamicResource Brand}" Click="ChangeFolder_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
            <TextBlock Style="{StaticResource DialogTitle}" Text="Copy design" />
            <TextBlock Style="{StaticResource DialogIntro}"
                       Text="Tick the files to copy and give each copy a new name. Copies point at the other copies; files you don't tick (e.g. library and buyout parts) stay shared. The originals aren't changed." />
        </StackPanel>
        <DockPanel Margin="{StaticResource DialogBodyPadding}">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Label Content="Number the copies from" Target="{Binding ElementName=Schemes}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox x:Name="Schemes" DisplayMemberPath="Name" MinWidth="260" HorizontalAlignment="Left" SelectionChanged="Schemes_SelectionChanged"
                          ToolTip="Each copied model gets the scheme's next free number; a drawing named like its model gets the same number." />
            </DockPanel>
            <Grid x:Name="ManualNaming" DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="8" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Label Content="Replace" Target="{Binding ElementName=FindText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox x:Name="FindText" Grid.Column="1" TextChanged="Naming_Changed" />
                <Label Content="with" Grid.Column="2" Target="{Binding ElementName=ReplaceText}" VerticalAlignment="Center" Margin="12,0" />
                <TextBox x:Name="ReplaceText" Grid.Column="3" TextChanged="Naming_Changed" />
                <Label Content="Prefix" Grid.Row="2" Target="{Binding ElementName=PrefixText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox x:Name="PrefixText" Grid.Row="2" Grid.Column="1" TextChanged="Naming_Changed" />
                <Label Content="Suffix" Grid.Row="2" Grid.Column="2" Target="{Binding ElementName=SuffixText}" VerticalAlignment="Center" Margin="12,0" />
                <TextBox x:Name="SuffixText" Grid.Row="2" Grid.Column="3" TextChanged="Naming_Changed" />
            </Grid>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource ErrorBar}" Margin="0,12,0,0" Visibility="{Binding Visibility, ElementName=Problem}">
                <DockPanel>
                    <TextBlock Style="{StaticResource MessageIcon}" Text="&#xE783;" Foreground="{DynamicResource DangerText}" />
                    <TextBlock x:Name="Problem" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Visibility="Collapsed" />
                </DockPanel>
            </Border>
            <DataGrid x:Name="Items" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" RowHeight="34" AutomationProperties.Name="Files to copy">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Copy" Width="56">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Copy, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                          AutomationProperties.Name="{Binding Name, StringFormat=Copy {0}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Original" Binding="{Binding Name}" IsReadOnly="True" Width="1.4*" />
                    <DataGridTemplateColumn Header="New Name" Width="1.4*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Padding="5,3"
                                         AutomationProperties.Name="{Binding Name, StringFormat=New name for {0}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" IsReadOnly="True" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>
